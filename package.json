{
  "name": "motion-reel-kit",
  "version": "1.0.0",
  "private": true,
  "description": "Code-generated motion graphics for YouTube: 15 reusable, param-driven styles across 30+ niches, rendered to frame-exact MP4s with synthesized sound.",
  "license": "MIT",
  "author": "dvaknin001",
  "homepage": "https://github.com/dvaknin001/motion-reel-kit#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/dvaknin001/motion-reel-kit.git"
  },
  "bugs": {
    "url": "https://github.com/dvaknin001/motion-reel-kit/issues"
  },
  "keywords": [
    "motion-graphics",
    "youtube",
    "video",
    "gsap",
    "ffmpeg",
    "puppeteer",
    "animation",
    "kinetic-typography",
    "data-visualization"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "doctor": "node tools/doctor.mjs",
    "test": "node tools/doctor.mjs",
    "list": "node tools/params.mjs --list",
    "params": "node tools/params.mjs",
    "render": "node tools/render.mjs",
    "dev": "node tools/dev.mjs",
    "new-reel": "node tools/new-reel.mjs",
    "new-style": "node tools/new-style.mjs",
    "export": "node tools/export-reel.mjs",
    "page": "node tools/build-page.mjs",
    "pagecheck": "node tools/pagecheck.mjs",
    "catalog": "node tools/catalog.mjs",
    "maps": "node tools/mapgen.mjs",
    "baseline": "node tools/regress.mjs snapshot",
    "regress": "node tools/regress.mjs check",
    "determinism": "node tools/regress.mjs determinism",
    "site": "node tools/build-site.mjs",
    "deploy-site": "node tools/build-site.mjs --deploy"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "ffmpeg-static": "^5.3.0",
    "puppeteer-core": "^25.12.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  }
}
